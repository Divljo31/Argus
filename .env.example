# ─── Chain & RPC ─────────────────────────────────────────────────────────────
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/REPLACE_ME
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/REPLACE_ME

# ─── Vault deploy inputs (read by contracts/script/Deploy.s.sol) ─────────────
# The wallet that deposits USDC and can always withdraw (your personal wallet
# for the demo, NOT the manager EOA).
VAULT_OWNER=0xREPLACE_ME
# Public address of the manager EOA — must match the address record on
# manager.argus.divljo.eth and the EOA whose key is in MANAGER_PRIVATE_KEY.
MANAGER_ADDRESS=0xREPLACE_ME
# Optional cap override; defaults to 50 USDC (50_000_000 with 6 decimals).
MAX_DEPOSIT_USDC_6DEC=50000000

# ─── Deployed contracts (filled in after deploy) ─────────────────────────────
VAULT_ADDRESS_BASE=
USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
AAVE_POOL_BASE=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
AUSDC_BASE=0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB

# ─── Agent identities ────────────────────────────────────────────────────────
# DO NOT use real funds beyond demo limits. Hackathon-grade keys only.
MANAGER_PRIVATE_KEY=0xREPLACE_ME
MANAGER_ENS=manager.argus.divljo.eth
MANAGER_HTTP_PORT=4001

WATCHER_PRIVATE_KEY=0xREPLACE_ME
WATCHER_ENS=watcher.argus.divljo.eth

# ─── External services ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
APIFY_TOKEN=apify_api_REPLACE_ME

# Comma-separated Telegram channel handles for tri_angle/telegram-scraper.
# Leave blank to skip Telegram scraping entirely.
TELEGRAM_CHANNELS=

# Apify x402 toggle. Only the Polymarket actor (PPE) routes through x402.
# The Twitter / Reddit / Telegram actors are PPR and stay on token auth.
# Set USE_X402=true after a dry-run confirms wire format with Apify.
USE_X402=false

# Namestone for ENS subname issuance
# Namestone unused — subnames are issued onchain via ENS NameWrapper under
# argus.divljo.eth. Leave blank.
NAMESTONE_API_KEY=
NAMESTONE_DOMAIN=

# Swarm (bee-js) — bzz.limo accepts NULL_STAMP and rewrites it to a real
# postage batch, so SWARM_POSTAGE_BATCH_ID can stay empty for the demo.
SWARM_GATEWAY_URL=https://bzz.limo
SWARM_POSTAGE_BATCH_ID=

# ─── Demo controls ───────────────────────────────────────────────────────────
THREAT_SCORE_THRESHOLD=60
WATCHER_POLL_INTERVAL_MS=30000
DEMO_MODE=true

# Mock classifier (only used when ANTHROPIC_API_KEY is empty/REPLACE_ME).
# MOCK_THREAT_LEVEL: low (0.0-0.3), medium (0.3-0.7), high (0.7-1.0), random (0-1)
MOCK_THREAT_LEVEL=random
# MOCK_TARGET_AAVE_PROB: probability classified item targets aave-v3 (0..1)
MOCK_TARGET_AAVE_PROB=0.7
