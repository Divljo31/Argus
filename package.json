{
  "name": "argus",
  "version": "0.0.0",
  "private": true,
  "description": "Two-agent USDC yield + threat watcher. Hackathon MVP.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:manager": "pnpm --filter @argus/manager dev",
    "dev:watcher": "pnpm --filter @argus/watcher dev",
    "dev:web": "pnpm --filter @argus/frontend dev"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "bufferutil",
      "esbuild",
      "keccak",
      "sharp",
      "utf-8-validate"
    ]
  }
}
